(footprint "PC104_J2P2_2x20_P2.54mm_Stackthrough"
	(version 20241229)
	(generator "retro104")
	(generator_version "1.0")
	(layer "F.Cu")
	(descr "PC/104 16-bit bus J2/P2, rows C/D, 2x20 (pins 0..19), 2.54 mm. Geometry: PC/104 Specification v2.6 Fig. 3/4: C0/D0 0.800 in from J1 pin 1, rows at 0.100 in towards the bus edge. Origin = C0. Silk edge towards J1/P1 is shared with the J1/P1 outline. Part: Samtec ESQ-120-39-G-D (stackthrough). C19 is the PC/104 key location. Advantech PCM-3864/3860 name: CN1 (its Row A/Row B = C/D).")
	(tags "PC/104 PC104 ISA stackthrough ESQ")
